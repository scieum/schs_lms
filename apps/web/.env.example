# .env.local 로 복사해서 채운다. 키는 절대 NEXT_PUBLIC_ 으로 시작하지 않는다 (C1).
# 둘 중 하나라도 비어 있으면 데모 모드(메모리 데이터)로 돈다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 세션 서명용, 32자 이상 무작위 문자열
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 첫 로그인 공통 인증코드. 코드에 적힌 기본값(schs-2026)을 쓰지 말 것
INITIAL_AUTH_CODE=
