# .env.local 로 복사해서 채운다. 키는 절대 NEXT_PUBLIC_ 으로 시작하지 않는다 (C1).
# 둘 중 하나라도 비어 있으면 데모 모드(메모리 데이터)로 돈다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 세션 서명용, 32자 이상 무작위 문자열
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 첫 로그인 공통 인증코드. 코드에 적힌 기본값(schs-2026)을 쓰지 말 것
INITIAL_AUTH_CODE=

# Claude API (영랑이 · AI 기능). 서버에서만 쓴다 — NEXT_PUBLIC_ 금지 (C1)
ANTHROPIC_API_KEY=

# 나이스 교육정보 개방 포털 (급식·학사일정). 키 없이도 되지만 넣으면 조회 제한이 풀린다. 학교 코드는 기본 속초고(K10/7801152)
NEIS_API_KEY=
# NEIS_OFFICE_CODE=K10
# NEIS_SCHOOL_CODE=7801152
# Vercel 크론(노션 동기화 · 자료 보존 자동 파기 /api/cron/retention 매일 KST 03시) 비밀값. Vercel 프로젝트 환경변수에도 같은 값
CRON_SECRET=
